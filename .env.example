# Supabase configuration (MI-8).
#
# Copy this file to `.env` and fill in the values from your project's API
# settings: https://app.supabase.com → Project → Settings → API.
#
# `.env` is gitignored — never commit real values.
#
# - URL: the BASE project URL (https://<ref>.supabase.co). supabase-js appends
#   /rest/v1, /auth/v1, etc. itself — do NOT use the /rest/v1/ endpoint here.
# - KEY: the PUBLISHABLE key (sb_publishable_...), the client-safe replacement
#   for the legacy anon key. NEVER use the sb_secret_ key in the app — it
#   bypasses Row-Level Security and would be exposed in the shipped bundle.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
